+std::string PluginLoader::get_camera_url(const std::string& dev_id,
+                                         int timeout_ms) {
+  if (!agent_) {
+    throw std::runtime_error("get_camera_url: agent not bootstrapped");
+  }
+  struct State {
+    std::promise<std::string> promise;
+    std::atomic<bool> delivered{false};
+  };
+  auto state = std::make_shared<State>();
+  auto future = state->promise.get_future();
+  int rc = p_get_camera_url_(agent_, dev_id, [state](std::string value) {
+    if (!state->delivered.exchange(true)) {
+      state->promise.set_value(std::move(value));
+    }
+  });
+  if (rc != 0) {
+    throw std::runtime_error("get_camera_url failed rc=" + std::to_string(rc));
+  }
+  if (future.wait_for(std::chrono::milliseconds(timeout_ms)) !=
+      std::future_status::ready) {
+    throw std::runtime_error("get_camera_url timed out");
+  }
+  std::string url = future.get();
+  if (url.rfind("bambu:///", 0) != 0) {
+    throw std::runtime_error("get_camera_url returned an invalid URL");
+  }
+  return url;
+}
