# Use the SAME proxy code as core.env and bootstrap.env.
PROXY_ACCESS_CODE=CHANGE_ME
ENDPOINT_REGISTRY=/data/printers.json
ENDPOINT_BROKER_HOST=127.0.0.1
ENDPOINT_BROKER_PORT=1883
ENDPOINT_TLS_BROKER_PORT=18883
ENDPOINT_STORAGE_API_URL=http://127.0.0.1:4844/internal/cloud-lan-proxy/storage
ENDPOINT_STAGING_ROOT=/staging
ENDPOINT_REMOTE_CACHE_DIR=/remote-cache
ENDPOINT_CAMERA_STATE_DIR=/camera-state
ENDPOINT_LOCAL_STATUS_DIR=/local-status
ENDPOINT_STATUS_FILE=/endpoint-state/status.json
