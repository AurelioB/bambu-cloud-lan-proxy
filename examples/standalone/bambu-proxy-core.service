[Unit]
Description=Bambu Cloud LAN Proxy — core
After=network-online.target bambu-proxy-broker.service
Wants=network-online.target

[Service]
Type=simple
User=bambu-proxy
Group=bambu-proxy
EnvironmentFile=/etc/bambu-proxy/environment
ExecStart=/usr/local/bin/bambu-cloud-lan-proxy service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/bambu-proxy
AmbientCapabilities=
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
