---
import '@fontsource-variable/inter';
import '../styles/landing.css';
import RequestFlow from '../components/RequestFlow.astro';
import HandyConnection from '../components/HandyConnection.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => `${base}${path}`;
const repo = 'https://github.com/AurelioB/bambu-cloud-lan-proxy';
const description =
  'Keep Bambu Handy. Connect Bambuddy and your local tools through a self-hosted virtual LAN endpoint for each printer.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f2" />
    <meta
      property="og:title"
      content="Bambu Cloud LAN Proxy — Cloud, meet local."
    />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={new URL(href('/social.svg'), Astro.site)}
    />
    <link rel="canonical" href={new URL(href('/'), Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <title>Bambu Cloud LAN Proxy — Cloud, meet local.</title>
    <script is:inline>
      try {
        const preference = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme =
          preference === 'light' || preference === 'dark'
            ? preference
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header wrap">
      <a class="brand" href={href('/')} aria-label="Bambu Cloud LAN Proxy home">
        <img src={href('/favicon.svg')} width="36" height="36" alt="" />
        <span>
          bambu<span class="brand-dot">.</span>
          <small>CLOUD LAN PROXY</small>
        </span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#features">Features</a>
        <a href={href('/docs/')}>Docs</a>
        <a href={repo}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
      <button
        class="theme-switch"
        aria-label="Switch color theme"
        title="Switch color theme"
      >
        <span aria-hidden="true">◐</span>
      </button>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot"></span> Independent. Self-hosted. Yours.
          </p>
          <h1 id="hero-title">
            Cloud,
            <br />
            meet <em>local.</em>
          </h1>
          <p class="hero-description">
            Your printers shouldn’t have to pick sides. Keep Bambu Handy
            connected, and bring your favorite local tools along.
          </p>
          <div class="actions">
            <a class="button primary" href={href('/docs/install/compose/')}>
              Set up your proxy <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#request-flow">
              Follow a request <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="hero-footnote">
            Linux x86-64 · Docker or standalone · MIT-licensed code
          </p>
        </div>
        <div
          class="connection-illustration"
          role="img"
          aria-label="Bambuddy and local tools connect to one virtual IP per printer. The proxy uses Bambu Cloud for signed commands and the printer LAN for supported local services. Bambu Handy stays cloud connected."
        >
          <div class="diagram-label">A BRIDGE TO YOUR WORKSPACE</div>
          <div class="diagram-row apps">
            <div class="node">
              <span class="node-icon">⌘</span>
              <strong>Your local tools</strong>
              <small>Bambuddy · Studio</small>
            </div>
            <div class="node">
              <span class="node-icon">☁</span>
              <strong>Bambu Cloud</strong>
              <small>Handy stays connected</small>
            </div>
          </div>
          <div class="wires">
            <span>LAN protocols</span>
            <span>Signed commands</span>
          </div>
          <div class="proxy-node">
            <img src={href('/favicon.svg')} width="52" height="52" alt="" />
            <div>
              <strong>Cloud LAN Proxy</strong>
              <span>One shared cloud account</span>
            </div>
            <span class="proxy-pulse" aria-hidden="true"></span>
          </div>
          <div class="printer-lines" aria-hidden="true"></div>
          <div class="diagram-row printers">
            {['Workshop', 'Studio', 'Little maker'].map((name, i) => (
              <div class="printer-node">
                <svg viewBox="0 0 64 66" aria-hidden="true">
                  <path
                    d="m12 15 30-5 12 8v37l-30 7-12-9Zm0 0 12 9 30-6M24 24v38M18 29v18l6 4m7-22 15-3v20l-15 4Zm2 22 17-4M36 29v8l4 3 4-5v-8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linejoin="round"
                  />
                </svg>
                <strong>{name}</strong>
                <small>Virtual IP · {i + 1}</small>
              </div>
            ))}
          </div>
          <p class="diagram-caption">
            A familiar LAN connection. For every printer.
          </p>
        </div>
      </section>
      <section class="principles wrap" aria-label="Project highlights">
        <p>
          <span>01 /</span> Keep your cloud connection
        </p>
        <p>
          <span>02 /</span> Give each printer its own IP
        </p>
        <p>
          <span>03 /</span> Choose what clients can do
        </p>
      </section>
      <HandyConnection />
      <RequestFlow />
      <section
        id="features"
        class="section wrap"
        aria-labelledby="features-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">YOUR TOOLS. WORKING TOGETHER.</p>
            <h2 id="features-title">
              More connected.
              <br />
              Still in your control.
            </h2>
          </div>
          <p>
            A LAN-shaped interface for cloud-paired Bambu Lab printers. Built
            around the tools you already use.
          </p>
        </div>
        <div class="feature-grid">
          <article class="feature-card wide">
            <span class="feature-index">01 — CONNECT</span>
            <h3>
              One printer. One address.
              <br />
              One place for the whole fleet.
            </h3>
            <p>
              Give each printer a reserved virtual IP, then add it to Bambuddy
              using the usual ports and access code. One shared cloud login
              powers the workspace.
            </p>
            <a class="text-link" href={href('/docs/networking/')}>
              How multiple printers work <span aria-hidden="true">→</span>
            </a>
            <div class="ip-list" aria-hidden="true">
              <span>
                Workshop <code>192.168.1.201</code>
              </span>
              <span>
                Studio <code>192.168.1.202</code>
              </span>
              <span>
                Little maker <code>192.168.1.203</code>
              </span>
            </div>
          </article>
          <article class="feature-card">
            <span class="feature-index">02 — OBSERVE</span>
            <h3>
              Local when possible.
              <br />
              Cloud when needed.
            </h3>
            <p>
              Prefer fresh local telemetry when the printer allows it. Fall back
              to cloud reports. Relay supported liveview directly over your LAN.
            </p>
            <a class="text-link" href={href('/docs/features/')}>
              Follow the data paths <span aria-hidden="true">→</span>
            </a>
          </article>
          <article class="feature-card">
            <span class="feature-index">03 — CONTROL</span>
            <h3>
              Your permissions.
              <br />
              Your call.
            </h3>
            <p>
              Start read-only. Opt into signed cloud controls, printing,
              reprints, and file mutations. Add a local admin login or OIDC
              without changing your printer clients.
            </p>
            <a class="text-link" href={href('/docs/permissions/')}>
              Understand the controls <span aria-hidden="true">→</span>
            </a>
          </article>
          <article class="feature-card wide files-card">
            <span class="feature-index">04 — ACCESS</span>
            <h3>Bring files back into the picture.</h3>
            <p>
              Browse previous jobs and timelapses through the native file
              service. Stage new jobs over FTPS. Printer storage prefers a local
              connection, with a cloud tunnel fallback.
            </p>
            <a
              class="text-link"
              href={href('/docs/features/#files-and-timelapses')}
            >
              Explore file services <span aria-hidden="true">→</span>
            </a>
            <div class="file-chips" aria-hidden="true">
              <span>↳ previous jobs</span>
              <span>↳ timelapses</span>
              <span>↳ staged prints</span>
            </div>
          </article>
        </div>
        <p class="section-note">
          Capabilities vary by model and firmware. Image-camera translation is
          not supported, and signed controls still need Bambu Cloud.{' '}
          <a href={href('/docs/compatibility/')}>Check compatibility →</a>
        </p>
      </section>
      <section class="workspace-section" aria-labelledby="workspace-title">
        <div class="wrap section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">A LITTLE LESS ADMIN.</p>
              <h2 id="workspace-title">Meet your printer workspace.</h2>
            </div>
            <p>
              Connection health, model capabilities, and permission controls. A
              calm console for a busy workbench.
            </p>
          </div>
          <figure class="console-preview">
            <a
              href={href('/console-preview.png')}
              aria-label="Open full admin console preview"
            >
              <img
                src={href('/console-preview.png')}
                alt="Admin console with five example printers, individual connection health, and model-specific camera capabilities."
                width="1440"
                height="1979"
                loading="lazy"
              />
            </a>
            <figcaption>
              Admin console · illustrative demo data · no connection to your
              printers
            </figcaption>
          </figure>
        </div>
      </section>
      <section
        id="install"
        class="section wrap"
        aria-labelledby="install-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">MAKE YOURSELF AT HOME.</p>
            <h2 id="install-title">Self-host it your way.</h2>
          </div>
          <p>
            No Gateway installation. No hosted proxy account. You run the bridge
            on your own Linux machine.
          </p>
        </div>
        <div class="install-grid">
          <a
            class="install-card recommended"
            href={href('/docs/install/compose/')}
          >
            <span class="feature-index">RECOMMENDED</span>
            <h3>
              Docker Compose <span aria-hidden="true">↗</span>
            </h3>
            <p>
              Certificates, broker, cloud core, and printer endpoints. One
              coordinated stack.
            </p>
            <code>./scripts/deploy.sh</code>
          </a>
          <a class="install-card" href={href('/docs/install/docker/')}>
            <span class="feature-index">BRING YOUR OWN ORCHESTRATION</span>
            <h3>
              Docker <span aria-hidden="true">↗</span>
            </h3>
            <p>
              Build the image locally and run the services explicitly. Same
              components, your lifecycle.
            </p>
            <code>docker build -f Dockerfile.proxy …</code>
          </a>
          <a class="install-card" href={href('/docs/install/standalone/')}>
            <span class="feature-index">FOR LINUX OPERATORS</span>
            <h3>
              Standalone <span aria-hidden="true">↗</span>
            </h3>
            <p>
              Build Rust and the native adapter. Run the services under systemd,
              without Docker.
            </p>
            <code>cargo build --locked --release</code>
          </a>
        </div>
        <p class="section-note">
          Requires Linux x86-64, a cloud-paired printer, and a trusted private
          network. The official Bambu networking plugin is downloaded separately
          and verified against reviewed hashes.
        </p>
      </section>
      <section class="closing wrap">
        <div>
          <p class="eyebrow">BUILT FOR THE COMMUNITY.</p>
          <h2>A bridge, not a walled garden.</h2>
          <p>
            Readable source. Documented interfaces. A home for the setup you
            want to run.
          </p>
        </div>
        <a class="button primary" href={href('/docs/')}>
          Start with the guide <span aria-hidden="true">→</span>
        </a>
      </section>
    </main>
    <footer class="wrap footer">
      <div>
        <strong>Bambu Cloud LAN Proxy</strong>
        <p>
          Independent community software. Not affiliated with or endorsed by
          Bambu Lab.
        </p>
      </div>
      <nav aria-label="Footer">
        <a href={href('/docs/operations/')}>Security</a>
        <a href={href('/docs/api/')}>API</a>
        <a href={repo}>Source ↗</a>
      </nav>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-switch');
      button?.addEventListener('click', () => {
        const theme =
          document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('starlight-theme', theme);
        } catch {
          /* Theme still works without storage. */
        }
        button.setAttribute(
          'aria-label',
          `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`,
        );
      });
    </script>
  </body>
</html>
