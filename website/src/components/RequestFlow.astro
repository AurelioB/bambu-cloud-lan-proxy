---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const requests = [
  ['files', 'File browsing'],
  ['camera', 'Camera access'],
  ['controls', 'Printer controls'],
  ['status', 'Status reports'],
  ['staging', 'Job staging'],
  ['printing', 'Start a staged job'],
  ['reprint', 'Reprint a stored job'],
  ['queries', 'Read-only queries'],
  ['storage', 'Storage uploads / deletes'],
];
const layouts = [
  {
    name: 'desktop',
    viewBox: '0 0 1000 340',
    entry: 'M 130 220 H 440',
    local: 'M 440 220 H 850',
    cloud: 'M 440 220 V 90 Q 440 65 465 65 H 825 Q 850 65 850 90 V 220',
    routes: {
      local: 'M 130 220 H 850',
      cloud: 'M 130 220 H 440 V 90 Q 440 65 465 65 H 825 Q 850 65 850 90 V 220',
      staging: 'M 130 220 H 440',
    },
  },
  {
    name: 'mobile',
    viewBox: '0 0 360 440',
    entry: 'M 105 55 V 210',
    local: 'M 105 210 V 365',
    cloud: 'M 105 210 H 270 V 345 Q 270 365 250 365 H 105',
    routes: {
      local: 'M 105 55 V 365',
      cloud: 'M 105 55 V 210 H 270 V 345 Q 270 365 250 365 H 105',
      staging: 'M 105 55 V 210',
    },
  },
];
---

<section id="request-flow" class="section wrap" aria-labelledby="flow-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">FOLLOW A REQUEST.</p>
      <h2 id="flow-title">
        Same proxy.
        <br />
        Different routes.
      </h2>
    </div>
    <p>
      Your app sees a virtual LAN printer, not the real printer’s connection
      mode. The proxy selects the route per operation: local-first where
      supported, cloud where required.
    </p>
  </div>

  <request-flow data-route="local" data-operation="files" data-paused="true">
    <fieldset class="flow-choices" disabled>
      <legend>Choose an operation</legend>
      {requests.map(([value, label]) => (
        <label>
          <input
            type="radio"
            name="request-flow-operation"
            value={value}
            checked={value === 'files'}
          />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>

    <div class="flow-surface">
      <div class="flow-toolbar">
        <p class="flow-route">
          <span class="flow-route-dot" aria-hidden="true"></span>
          <span data-route-label>Local connection</span>
        </p>
        <button type="button" data-play disabled>
          Play animation
        </button>
      </div>

      <div class="flow-canvas" aria-hidden="true">
        {layouts.map((layout) => (
          <svg
            class={`flow-wires flow-${layout.name}`}
            viewBox={layout.viewBox}
            preserveAspectRatio="none"
          >
            <path class="flow-wire flow-entry" d={layout.entry} />
            <path class="flow-wire flow-local-wire" d={layout.local} />
            <path class="flow-wire flow-cloud-wire" d={layout.cloud} />
            {Object.entries(layout.routes).map(([route, d]) => (
              <g data-flow-route={route}>
                <path class="flow-packet flow-request" pathLength="100" d={d} />
                <path class="flow-packet flow-reply" pathLength="100" d={d} />
              </g>
            ))}
          </svg>
        ))}
        <div class="flow-node flow-app">
          <span class="flow-node-kicker">YOUR LOCAL APP</span>
          <strong>Bambuddy · Studio</strong>
          <span>LAN-compatible client</span>
        </div>
        <div class="flow-node flow-proxy">
          <span class="flow-node-kicker">ON YOUR HOST</span>
          <strong>Cloud LAN Proxy</strong>
          <span data-proxy-detail>Local-first file access</span>
        </div>
        <div class="flow-node flow-cloud">
          <span class="flow-node-kicker">VIA THE INTERNET</span>
          <strong>Bambu Cloud</strong>
          <span data-cloud-detail>Media tunnel fallback</span>
        </div>
        <div class="flow-node flow-printer">
          <span class="flow-node-kicker">THE REAL DEVICE</span>
          <strong>Your printer</strong>
          <span>Still cloud-paired</span>
        </div>
        <span class="flow-local-label">Direct LAN</span>
        <span class="flow-incoming-label" data-incoming-label>
          Request →
        </span>
      </div>

      <div class="flow-bottom">
        <div class="flow-legend" role="group" aria-label="Animation legend">
          <span>
            <i class="flow-request-key" aria-hidden="true"></i>Request / upload
          </span>
          <span>
            <i class="flow-reply-key" aria-hidden="true"></i>Returned data /
            reports
          </span>
        </div>
        <span class="flow-demo-label">
          Illustration only · no printer connection
        </span>
      </div>
    </div>

    <div class="flow-settings">
      <label data-fallback-control>
        <input type="checkbox" data-fallback disabled />
        <span data-fallback-label>Simulate local file access unavailable</span>
      </label>
      <p data-route-rule hidden></p>
      <span class="flow-motion-note" data-motion-note hidden>
        Reduced motion: static routes. You can opt into animation.
      </span>
    </div>
    <p class="flow-explanation" data-explanation role="status">
      File request → proxy → printer LAN. File data returns over the same local
      connection. If a local connection cannot be established, the proxy can use
      Bambu’s cloud media tunnel.
    </p>
    <noscript>
      <p class="section-note">
        JavaScript is disabled. This diagram shows the local file route. See the
        feature guide for all routes and fallbacks.
      </p>
    </noscript>
  </request-flow>

  <div class="routing-summary" aria-label="Routing rules at a glance">
    <article>
      <span>01 / LOCAL FIRST</span>
      <h3>Reports & printer files</h3>
      <p>
        Fresh local reports take priority. File sessions try LAN first. Cloud is
        the fallback when those local paths are unavailable.
      </p>
    </article>
    <article>
      <span>02 / CLOUD REQUIRED</span>
      <h3>Commands & printing</h3>
      <p>
        Controls, print submission, reprints, and explicit read-only queries go
        through cloud. There is no local-write fallback.
      </p>
    </article>
    <article>
      <span>03 / LOCAL ONLY</span>
      <h3>Supported cameras</h3>
      <p>
        Liveview uses local RTSPS or the image service, according to model. If
        it is unavailable, the proxy does not switch video to cloud.
      </p>
    </article>
    <article>
      <span>04 / PROXY ONLY</span>
      <h3>FTPS job staging</h3>
      <p>
        Staged files stay on your proxy host until a separate, permitted
        operation sends them onward.
      </p>
    </article>
  </div>
  <p class="section-note">
    Local services depend on model, firmware, and configured credentials.
    Controls and printer-storage mutations still require their respective
    permissions; an unavailable route never bypasses policy. Cloud media
    fallback happens when opening a file connection, not by replaying a failed
    mutation.{' '}
    <a href={`${base}/docs/features/`}>Read the complete routing guide →</a>
  </p>
</section>

<script>
  type Operation =
    | 'files'
    | 'camera'
    | 'controls'
    | 'status'
    | 'staging'
    | 'printing'
    | 'reprint'
    | 'queries'
    | 'storage';
  class RequestFlow extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      // Reconnection must not duplicate observers or event handlers.
      this.cleanup?.();
      const controller = new AbortController();
      const { signal } = controller;
      const select = <T extends HTMLElement>(selector: string) =>
        this.querySelector<T>(selector)!;
      const play = select<HTMLButtonElement>('[data-play]');
      const fallback = select<HTMLInputElement>('[data-fallback]');
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let paused = motion.matches;
      let visible = false;
      const updatePlayback = () => {
        this.dataset.paused = String(paused || !visible || document.hidden);
        play.textContent = paused ? 'Play animation' : 'Pause animation';
      };
      const update = () => {
        const operation = select<HTMLInputElement>(
          'input[type="radio"]:checked',
        ).value as Operation;
        const hasFallback =
          operation === 'files' ||
          operation === 'status' ||
          operation === 'storage';
        const cloud =
          ['controls', 'printing', 'reprint', 'queries'].includes(operation) ||
          (hasFallback && fallback.checked);
        this.dataset.operation = operation;
        this.dataset.route =
          operation === 'staging' ? 'staging' : cloud ? 'cloud' : 'local';
        select('[data-fallback-control]').hidden = !hasFallback;
        fallback.disabled = !hasFallback;
        select('[data-fallback-label]').textContent =
          operation === 'status'
            ? 'Simulate stale or unavailable local reports'
            : 'Simulate local file access unavailable';
        const rule = select('[data-route-rule]');
        rule.hidden = hasFallback;
        const copy = {
          files: {
            label: cloud ? 'Cloud media fallback' : 'Local connection',
            proxy: 'Local-first file access',
            cloud: 'Media tunnel fallback',
            rule: '',
            explanation: cloud
              ? 'Local file connection unavailable: request → proxy → Bambu Cloud media tunnel → printer. File data returns through the tunnel to your app.'
              : 'File request → proxy → printer LAN. File data returns over the same local connection. If a local connection cannot be established, the proxy can use Bambu’s cloud media tunnel.',
          },
          camera: {
            label: 'Local only',
            proxy: 'Local camera relay',
            cloud: 'Not used for liveview',
            rule: 'No cloud fallback. Supported models use RTSPS on port 322 or the image/file listener on port 6000. Requires local liveview and printer credentials.',
            explanation:
              'Liveview request → proxy → printer LAN. The video stream returns locally. If the local camera is unavailable, this route fails; it does not switch to the cloud.',
          },
          controls: {
            label: 'Cloud-signed control',
            proxy: 'Policy check + signing',
            cloud: 'Signed command delivery',
            rule: 'Cloud required. Only commands allowed by your configured policy are forwarded.',
            explanation:
              'Control request → proxy → Bambu Cloud → printer. The proxy checks permissions and uses the official plugin’s signing path. Status reports return separately; the animation does not imply an acknowledged or successful command.',
          },
          status: {
            label: cloud ? 'Cloud report fallback' : 'Fresh local reports',
            proxy: 'Prefer fresh local reports',
            cloud: 'Cloud telemetry',
            rule: '',
            explanation: cloud
              ? 'Local reports are stale or unavailable: printer → Bambu Cloud → proxy → local app. These are incoming telemetry reports, not cloud-signed write requests.'
              : 'Printer LAN → proxy → local app. Fresh read-only MQTT reports take precedence. This is a subscribed telemetry stream, not a separate upstream request for every update.',
          },
          staging: {
            label: 'Stops at the proxy',
            proxy: 'Local FTPS staging',
            cloud: 'Not used for staging',
            rule: 'Staging does not start a print or upload into physical printer storage.',
            explanation:
              'FTPS upload → proxy staging. The file stays on the proxy host. A separate, permitted print-submission or printer-storage operation is needed to send it onward.',
          },
          printing: {
            label: 'Cloud print submission',
            proxy: 'Check print permission',
            cloud: 'Job upload + dispatch',
            rule: 'Requires cloud printing to be enabled. A staged file alone is not permission to print.',
            explanation:
              'Start request → proxy → Bambu Cloud → printer. The proxy submits the staged job through the official plugin. A timeout can mean an unknown outcome; it is not permission to replay the request. Status reports arrive separately.',
          },
          reprint: {
            label: 'Cloud-signed reprint',
            proxy: 'Check reprint permission',
            cloud: 'Signed command delivery',
            rule: 'Requires full control (or unsafe mode) and remote reprint permission; separate from staged cloud printing.',
            explanation:
              'Reprint request → proxy → Bambu Cloud → printer. The signed command references a file already on the printer; it does not upload that file again or fall back to local control. Status reports arrive separately.',
          },
          queries: {
            label: 'Cloud read-only query',
            proxy: 'Allowlisted query',
            cloud: 'Read-only request delivery',
            rule: 'Explicit queries use cloud; they are different from the local-first telemetry subscription.',
            explanation:
              'Read-only query → proxy → Bambu Cloud → printer. Allowed requests such as version, accessories, or pushall use the cloud plugin’s send path, not the signed-control path. Reports return on the telemetry stream, where fresh local reports take priority.',
          },
          storage: {
            label: cloud ? 'Cloud media fallback' : 'Local storage connection',
            proxy: 'Check storage permission',
            cloud: 'Media tunnel fallback',
            rule: '',
            explanation: cloud
              ? 'If a local file connection cannot be established, an allowed upload or delete uses proxy → Bambu Cloud media tunnel → printer. Fallback is chosen at connection setup, not by replaying a mutation after an uncertain result. Firmware may still reject the operation.'
              : 'Allowed upload or delete → proxy → printer LAN file service. Storage mutation permissions are checked first. A connection failure can select the cloud media tunnel; it does not bypass permissions or automatically replay a failed mutation.',
          },
        }[operation];
        select('[data-route-label]').textContent = copy.label;
        select('[data-proxy-detail]').textContent = copy.proxy;
        select('[data-cloud-detail]').textContent = copy.cloud;
        select('[data-explanation]').textContent = copy.explanation;
        select('[data-incoming-label]').textContent =
          operation === 'status'
            ? '← Reports'
            : operation === 'staging'
              ? 'Upload →'
              : 'Request →';
        rule.textContent = copy.rule;
      };
      this.addEventListener('change', update, { signal });
      play.addEventListener(
        'click',
        () => {
          paused = !paused;
          updatePlayback();
        },
        { signal },
      );
      document.addEventListener('visibilitychange', updatePlayback, { signal });
      motion.addEventListener(
        'change',
        () => {
          paused = motion.matches;
          select('[data-motion-note]').hidden = !motion.matches;
          updatePlayback();
        },
        { signal },
      );
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        updatePlayback();
      });
      observer.observe(this);
      select('[data-motion-note]').hidden = !motion.matches;
      play.disabled = false;
      select<HTMLFieldSetElement>('.flow-choices').disabled = false;
      update();
      updatePlayback();
      this.cleanup = () => {
        controller.abort();
        observer.disconnect();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('request-flow'))
    customElements.define('request-flow', RequestFlow);
</script>

<style>
  .routing-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .routing-summary article {
    border-top: 2px solid var(--border);
    padding-top: 20px;
  }
  .routing-summary article > span {
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .routing-summary h3 {
    font-size: 16px;
    margin: 12px 0 8px;
  }
  .routing-summary p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 900px) {
    .routing-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .routing-summary {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  request-flow {
    display: block;
    --flow-local: var(--primary);
    --flow-cloud: #77551b;
    --flow-reply: #3e6d91;
    --flow-active: var(--flow-local);
  }
  :global([data-theme='dark']) request-flow {
    --flow-cloud: #e7bd78;
    --flow-reply: #94c8eb;
  }
  request-flow[data-route='cloud'] {
    --flow-active: var(--flow-cloud);
  }
  .flow-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 20px;
    border: 0;
  }
  .flow-choices legend {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .flow-choices label {
    position: relative;
    cursor: pointer;
  }
  .flow-choices input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .flow-choices span {
    display: block;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card);
    font-size: 13px;
  }
  .flow-choices input:checked + span {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
  }
  .flow-choices input:focus-visible + span {
    outline: 3px solid var(--primary);
    outline-offset: 3px;
  }
  .flow-surface {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    overflow: hidden;
  }
  .flow-toolbar,
  .flow-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 20px 24px;
  }
  .flow-route {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--flow-active);
  }
  .flow-route-dot {
    width: 7px;
    height: 7px;
    background: currentColor;
    border-radius: 50%;
  }
  [data-play] {
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 7px;
    color: var(--foreground);
    background: var(--card);
    cursor: pointer;
    font-size: 12px;
  }
  [data-play]:disabled {
    cursor: default;
  }
  .flow-canvas {
    position: relative;
    height: 340px;
    background-image: radial-gradient(var(--grid) 0.8px, transparent 0.8px);
    background-size: 16px 16px;
  }
  .flow-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
  }
  .flow-mobile {
    display: none;
  }
  .flow-wire {
    stroke: var(--grid);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .flow-cloud-wire {
    stroke-dasharray: 6 6;
  }
  .flow-entry {
    stroke: var(--flow-active);
  }
  [data-route='local'] .flow-local-wire {
    stroke: var(--flow-active);
  }
  [data-route='cloud'] .flow-cloud-wire {
    stroke: var(--flow-active);
  }
  [data-flow-route] {
    display: none;
  }
  [data-route='local'] [data-flow-route='local'],
  [data-route='cloud'] [data-flow-route='cloud'],
  [data-route='staging'] [data-flow-route='staging'] {
    display: block;
  }
  .flow-packet {
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 1 99;
    opacity: 0;
  }
  .flow-request {
    stroke: var(--flow-active);
    animation: request-packet 6s linear infinite;
  }
  .flow-reply {
    stroke: var(--flow-reply);
    animation: reply-packet 6s linear 3s infinite;
  }
  [data-paused='true'] .flow-packet {
    animation-play-state: paused;
  }
  [data-operation='status'] .flow-request {
    display: none;
  }
  [data-operation='controls'] .flow-reply,
  [data-operation='printing'] .flow-reply,
  [data-operation='reprint'] .flow-reply,
  [data-operation='queries'] .flow-reply {
    display: none;
  }
  [data-operation='status'] .flow-reply {
    animation-delay: 0s;
  }
  @keyframes request-packet {
    0% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    46% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    50%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
  @keyframes reply-packet {
    0% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    46% {
      stroke-dashoffset: 100;
      opacity: 1;
    }
    50%,
    100% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
  }
  .flow-node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 190px;
    min-height: 104px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    padding: 17px;
    box-shadow: var(--shadow);
  }
  .flow-node-kicker {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.4px;
  }
  .flow-node strong {
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.4px;
  }
  .flow-node > span:last-child {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.4;
  }
  .flow-app {
    left: 13%;
    top: 64.7059%;
  }
  .flow-proxy {
    left: 44%;
    top: 64.7059%;
    border: 2px solid var(--flow-active);
  }
  .flow-cloud {
    left: 64.5%;
    top: 19.1176%;
  }
  .flow-printer {
    left: 85%;
    top: 64.7059%;
  }
  [data-route='cloud'] .flow-cloud {
    border-color: var(--flow-active);
  }
  [data-route='staging'] .flow-printer {
    border-style: dashed;
  }
  .flow-local-label,
  .flow-incoming-label {
    position: absolute;
    transform: translateX(-50%);
    font-size: 11px;
    color: var(--muted);
  }
  .flow-local-label {
    left: 64.5%;
    top: 74%;
  }
  .flow-incoming-label {
    left: 28.5%;
    top: 74%;
  }
  .flow-bottom {
    border-top: 1px solid var(--border);
  }
  .flow-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 11px;
    color: var(--muted);
  }
  .flow-legend span {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }
  .flow-legend i {
    width: 18px;
    height: 4px;
    border-radius: 2px;
    background: var(--flow-active);
  }
  .flow-legend .flow-reply-key {
    background: var(--flow-reply);
  }
  .flow-demo-label {
    font-size: 10px;
    color: var(--muted);
  }
  .flow-settings {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding-block: 16px;
  }
  .flow-settings label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    cursor: pointer;
    min-height: 28px;
  }
  .flow-settings input {
    accent-color: var(--primary);
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }
  .flow-settings p,
  .flow-motion-note {
    color: var(--muted);
    font-size: 12px;
    margin: 0;
    line-height: 1.6;
  }
  .flow-explanation {
    border-left: 2px solid var(--flow-active);
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
    max-width: 880px;
    min-height: 76px;
  }
  [hidden] {
    display: none !important;
  }
  @media (max-width: 900px) and (min-width: 721px) {
    .flow-node {
      width: 155px;
      padding: 13px;
    }
    .flow-node strong {
      font-size: 14px;
    }
  }
  @media (max-width: 720px) {
    .flow-desktop {
      display: none;
    }
    .flow-mobile {
      display: block;
    }
    .flow-canvas {
      height: 440px;
    }
    .flow-node {
      width: 145px;
      min-height: 100px;
      padding: 12px;
      gap: 8px;
    }
