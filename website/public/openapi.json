    "/internal/cloud-lan-proxy/storage/capabilities": {
      "get": {
        "summary": "Worker storage capabilities",
        "operationId": "get_internal_cloud_lan_proxy_storage_capabilities",
        "description": "",
        "security": [
          {
            "ServiceKey": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ability": {
                      "type": "boolean"
                    },
                    "list": {
                      "type": "boolean"
                    },
                    "download": {
                      "type": "boolean"
                    },
                    "subfile": {
                      "type": "boolean"
                    },
                    "upload": {
                      "type": "boolean"
                    },
                    "delete": {
                      "type": "boolean"
                    },
                    "notifications": {
                      "const": "revision",
                      "type": "string"
                    },
                    "time": {
                      "type": "integer"
                    }
                  },
