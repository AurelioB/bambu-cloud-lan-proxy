      "StorageRequest": {
        "type": "object",
        "properties": {
          "serial": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          },
          "api_version": {
            "type": "integer",
            "default": 2
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100
          },
          "source_path": {
            "type": "string"
          },
          "request": {},
          "cache_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{32}$"
          }
        },
        "required": []
      }
    }
  }
