    "/api/auth/login": {
      "post": {
        "summary": "Sign in with proxy code or local credentials",
        "operationId": "post_api_auth_login",
        "description": "Sets an HttpOnly session cookie. Mode controls accepted credentials. JSON limit 16 KiB.",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured admin origin; supplied by browsers."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            }
          },
          "default": {
            "description": "Application error JSON; framework validation errors may use text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Revoke the browser session",
        "operationId": "post_api_auth_logout",
        "description": "Requires CSRF when a valid session is present. Does not sign out the Bambu account.",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured admin origin; supplied by browsers."
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Required for session-authenticated mutations; not for direct service-key requests."
          }
        ],
        "responses": {
          "204": {
            "description": "Session revoked; cookies cleared"
          },
          "default": {
            "description": "Application error JSON; framework validation errors may use text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/oidc/start": {
      "post": {
        "summary": "Start admin OIDC",
        "operationId": "post_api_auth_oidc_start",
        "description": "Sets a separate browser-binding cookie. Navigate to the returned URL.",
        "security": [],
        "parameters": [
          {
            "in": "header",
