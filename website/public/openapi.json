                    "download",
                    "subfile",
                    "upload",
                    "delete",
                    "notifications",
                    "time"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Application error JSON; framework validation errors may use text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/internal/cloud-lan-proxy/storage/{operation}": {
      "post": {
        "summary": "Perform a worker storage operation",
        "operationId": "post_internal_cloud_lan_proxy_storage__operation_",
        "description": "Internal shared-filesystem interface. Fields depend on operation; see prose reference. Download/subfile return cache_key and size, not bytes. Mutations are policy gated. No browser-cookie authorization.",
        "security": [
          {
            "ServiceKey": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "operation",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ability",
                "list",
                "download",
                "subfile",
                "upload",
                "delete",
                "discard"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Application error JSON; framework validation errors may use text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StorageRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SecureSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-bambu-session",
        "description": "HTTPS session cookie."
      },
      "LoopbackSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bambu-session",
        "description": "Loopback HTTP development/default mode cookie."
      },
      "LegacyCode": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Cloud-Lan-Proxy-Key",
        "description": "Only accepted for admin endpoints in access_code mode."
      },
      "ServiceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Cloud-Lan-Proxy-Key",
        "description": "Required for internal worker routes in all admin modes; never publish it."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": ["detail"]
      },
      "Settings": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["read_only", "controls", "full_control"]
          },
          "allow_cancel": {
            "type": "boolean"
          },
          "cloud_print_enabled": {
            "type": "boolean"
          },
          "remote_reprint_enabled": {
            "type": "boolean"
          },
          "advertise_controls": {
            "type": "boolean"
          },
          "storage_allow_delete": {
            "type": "boolean"
          },
          "storage_allow_upload": {
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "allow_cancel",
          "cloud_print_enabled",
          "remote_reprint_enabled",
          "advertise_controls",
          "storage_allow_delete",
          "storage_allow_upload"
        ]
      },
      "Endpoint": {
        "type": "object",
        "properties": {
          "virtual_ip": {
            "type": "string"
          },
          "physical_ip": {
            "type": "string"
          },
          "physical_access_code": {
            "type": "string",
            "description": "Omit or leave empty to preserve the stored physical code. Otherwise eight ASCII letters/digits."
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["virtual_ip", "physical_ip", "enabled"]
      },
      "Session": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "username": {
            "type": ["string", "null"]
          },
          "csrf_token": {
            "type": ["string", "null"]
          },
          "access_code": {
            "type": "boolean"
          },
          "local": {
            "type": "boolean"
          },
          "oidc": {
            "type": "boolean"
          }
        },
        "required": [
          "authenticated",
          "username",
          "csrf_token",
          "access_code",
          "local",
          "oidc"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "access_code": {
            "type": "string",
            "format": "password"
          }
        },
        "required": []
      },
      "LoginResult": {
        "type": "object",
