{
  "openapi": "3.1.0",
  "info": {
    "title": "Bambu Cloud LAN Proxy HTTP API",
    "version": "0.7.0",
    "description": "Current-source reference, not a guarantee for the original v0.6.0 release. Printer protocols are separate. Session writes require Origin and CSRF. Service key cannot bypass local/OIDC admin authentication."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4844",
      "description": "Default loopback origin; replace with your own admin origin."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Minimal liveness",
        "operationId": "get_api_health",
        "description": "",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok",
                      "type": "string"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          },
          "default": {
            "description": "Application error JSON; framework validation errors may use text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
