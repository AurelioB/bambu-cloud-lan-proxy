            "type": "string",
            "enum": ["model_profile", "runtime_telemetry", "unknown"]
          },
          "model_known": { "type": "boolean" },
          "observed_fields": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "runtime": {
            "anyOf": [
              { "$ref": "#/components/schemas/ObservedCapabilities" },
              { "type": "null" }
            ]
          }
        },
        "required": [
          "camera",
          "local_camera_bridge",
          "chamber_temperature",
          "dual_nozzle",
          "source",
          "model_known",
          "observed_fields",
          "runtime"
        ]
      },
      "ObservedCapabilities": {
        "type": "object",
        "description": "Sanitized runtime evidence; firmware functions do not grant proxy permissions. Unknown counts are null; observed absence is zero.",
        "properties": {
          "updated_at": { "type": "integer", "minimum": 0 },
          "firmware": { "type": ["string", "null"] },
          "ams_units": { "type": ["integer", "null"], "minimum": 0 },
          "filament_slots": { "type": ["integer", "null"], "minimum": 0 },
          "ams": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          },
          "sensors": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "firmware_controls": {
            "type": "object",
            "additionalProperties": { "type": "boolean" }
          },
          "dual_nozzle": { "type": ["boolean", "null"] },
          "chamber_temperature": { "type": ["boolean", "null"] }
        },
        "required": [
          "updated_at",
          "firmware",
          "ams_units",
          "filament_slots",
          "ams",
          "sensors",
          "firmware_controls",
          "dual_nozzle",
          "chamber_temperature"
        ]
      },
      "Printer": {
        "type": "object",
        "properties": {
          "serial": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "virtual_ip": {
            "type": "string"
          },
          "physical_ip": {
            "type": "string"
          },
          "physical_access_configured": {
            "type": "boolean"
          },
          "endpoint_enabled": {
            "type": "boolean"
          },
          "online": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "secure_control": {
            "type": "boolean"
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "endpoint_health": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": ["disabled", "healthy", "degraded", "unavailable"]
              },
              "services": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "serial": {
                        "type": "string"
                      },
                      "virtual_ip": {
                        "type": "string"
                      },
                      "process_running": {
                        "type": "boolean"
                      },
                      "mqtt": {
                        "type": "boolean"
                      },
                      "ftps": {
                        "type": "boolean"
                      },
                      "files": {
                        "type": "boolean"
                      },
                      "camera": {
                        "type": ["boolean", "null"]
                      }
                    },
                    "required": [
                      "serial",
                      "virtual_ip",
                      "process_running",
                      "mqtt",
                      "ftps",
                      "files",
                      "camera"
                    ]
                  }
                ]
              }
            },
            "required": ["state", "services"]
          }
        },
        "required": [
          "serial",
          "name",
          "model",
          "virtual_ip",
          "physical_ip",
          "physical_access_configured",
          "endpoint_enabled",
          "online",
          "state",
          "secure_control",
          "capabilities",
          "endpoint_health"
        ]
      },
      "Overview": {
        "type": "object",
        "properties": {
          "healthy": {
            "type": "boolean"
          },
          "signed_in": {
            "type": "boolean"
          },
          "cloud_connected": {
            "type": "boolean"
          },
          "region": {
            "type": "string"
          },
          "printers": {
            "type": "array",
            "items": {
