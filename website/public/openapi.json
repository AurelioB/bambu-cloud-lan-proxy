                }
              }
            }
          }
        }
      }
    },
    "/api/auth/oidc/callback": {
      "get": {
        "summary": "Complete admin OIDC",
        "operationId": "get_api_auth_oidc_callback",
        "description": "Browser-binding cookie and single-use state required. Provider rejection may omit code.",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "code",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to / on success or /login?auth_error=oidc on failure",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Application error JSON; framework validation errors may use text.",
            "content": {
              "application/json": {
