{
  "name": "bambu-proxy-website",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build --force && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "npm run sync && astro check",
    "test": "playwright test",
    "format": "prettier --write src/pages src/components src/styles src/content.config.ts astro.config.mjs playwright.config.ts scripts tests package.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "0.42.4",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.2"
  }
}
