# syntax=docker/dockerfile:1

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS cloud-host-builder

ARG GATEWAY_COMMIT=79db09fff4929e9a7537453078031a51b3834c5f
ARG GATEWAY_ARCHIVE_SHA256=791bfab95edfbc801466434ca014ca4aa8495af9f21993ffe04bb9e595ef81f0
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates cmake curl g++ libssl-dev make patch \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSL "https://github.com/LeoLobato/bambu-gateway/archive/${GATEWAY_COMMIT}.tar.gz" -o /tmp/gateway.tar.gz \
 && echo "${GATEWAY_ARCHIVE_SHA256}  /tmp/gateway.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/gateway.tar.gz --strip-components=1 \
 && rm /tmp/gateway.tar.gz
COPY docker/gateway-host/upstream.patch /tmp/upstream.patch
COPY docker/gateway-host/storage_bridge.* tools/bambu_cloud_host/
RUN patch -p1 < /tmp/upstream.patch \
 && cmake -S tools/bambu_cloud_host -B /build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /build --parallel

# Bambu Gateway v3.0.0 (upstream commit 79db09fff4929e9a7537453078031a51b3834c5f).
# Pinning the digest makes the small compatibility hook fail predictably if
# Gateway's private APIs change in a later release.
FROM ghcr.io/leolobato/bambu-gateway@sha256:56073204264aad5eda98ef5e6d82a05316af64d0474de0f26c89a6b67496e145

ARG PROXY_VERSION="dev"
LABEL org.opencontainers.image.title="Bambu Cloud LAN Proxy" \
      org.opencontainers.image.description="Local MQTT facade for Bambu Gateway cloud printers" \
      org.opencontainers.image.version="${PROXY_VERSION}" \
      org.opencontainers.image.source="https://github.com/AurelioB/bambu-cloud-lan-proxy"

COPY src/bambu_cloud_lan_proxy /opt/bambu-cloud-lan-proxy/bambu_cloud_lan_proxy
COPY --from=cloud-host-builder /build/bambu_cloud_host /usr/local/bin/bambu_cloud_host

ENV PYTHONPATH="/opt/bambu-cloud-lan-proxy:/app"
ENTRYPOINT ["python", "-m", "bambu_cloud_lan_proxy.launcher"]
CMD ["-m", "app", "-c", "/data/printers.json"]
