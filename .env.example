TZ=America/Mexico_City
PUID=1000
PGID=1000

# Generated by ./scripts/init.sh. Exactly eight letters or digits.
PROXY_ACCESS_CODE=CHANGE_ME

# Loopback is safest when Bambuddy runs on this Docker host with host networking.
PROXY_BIND_IP=127.0.0.2
PROXY_MODE=read_only
# Use full_control only for a trusted client; it enables signed arbitrary MQTT
# commands supported by Bambu's cloud path.
PROXY_ALLOW_CANCEL=false
PROXY_ADVERTISE_CONTROLS=auto

# Direct Bambuddy queue dispatch remains a separate, explicit opt-in. FTPS
# staging and archive downloads work even while this stays false.
PROXY_CLOUD_PRINT_ENABLED=false
PROXY_CLOUD_PRINT_WAIT_SECONDS=900
PROXY_CLOUD_PRINT_PROGRESS_TIMEOUT=900
PROXY_FTPS_MAX_UPLOAD_MB=1024
PROXY_FTPS_MAX_TOTAL_MB=10240

# Optional comma-separated cloud printer serial allowlist. Empty exposes every
# printer present in the connected Gateway account.
PROXY_PRINTERS=

# H-series/X-series LAN-only liveview remains available while cloud-paired.
# Set the printer's current LAN IP; the physical camera access code is read
# from Gateway's private printers.json and is never copied into this file.
CAMERA_PRINTER_SERIAL=
CAMERA_UPSTREAM_IP=
CAMERA_UPSTREAM_PORT=322
# Optional explicit SHA-256 leaf pin. Empty uses persistent trust-on-first-use.
CAMERA_UPSTREAM_TLS_FINGERPRINT=

BAMBU_CLOUD_REGION=US
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=4844
