TZ=America/Mexico_City
PUID=1000
PGID=1000

# Generated by ./scripts/init.sh. Exactly eight letters or digits.
PROXY_ACCESS_CODE=CHANGE_ME

# Loopback is safest when Bambuddy runs on this Docker host with host networking.
PROXY_BIND_IP=127.0.0.2
PROXY_MODE=read_only
# Use full_control only for a trusted client; it enables signed arbitrary MQTT
# commands supported by Bambu's cloud path.
PROXY_ALLOW_CANCEL=false
PROXY_ADVERTISE_CONTROLS=auto

# Direct Bambuddy queue dispatch remains a separate, explicit opt-in. FTPS
# staging and native file browsing work even while this stays false.
PROXY_CLOUD_PRINT_ENABLED=false
PROXY_CLOUD_PRINT_WAIT_SECONDS=900
PROXY_CLOUD_PRINT_PROGRESS_TIMEOUT=900
PROXY_FTPS_MAX_UPLOAD_MB=1024
PROXY_FTPS_MAX_TOTAL_MB=10240

# Files downloaded for the native port-6000 facades are removed after each
# transfer. Every configured printer endpoint injects its own serial.
PROXY_STORAGE_MAX_DOWNLOAD_MB=4096
PROXY_STORAGE_SUBFILE_MAX_MB=256

# Physical storage writes and reprinting an existing printer file are separate
# opt-ins even in full-control mode. Enable only for a trusted local client.
PROXY_STORAGE_ALLOW_UPLOAD=false
PROXY_STORAGE_ALLOW_DELETE=false
PROXY_STORAGE_ALLOW_REPRINT=false

# Per-printer endpoints use static host aliases. Set the physical Linux
# interface used for non-loopback virtual IPs, for example eth0 or enp3s0.
# Keep the addresses outside the router's DHCP pool.
PROXY_ENDPOINT_INTERFACE=
PROXY_DISCOVERY_TARGET=255.255.255.255
PROXY_LOCAL_STATUS_ENABLED=true

# Optional comma-separated cloud printer serial allowlist. Empty exposes every
# printer present in the connected Bambu account.
PROXY_PRINTERS=

# Physical IPs and LAN liveview access codes are configured per printer in the
# admin console. Empty local details keep cloud telemetry/control available.

BAMBU_CLOUD_REGION=US
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=4844
